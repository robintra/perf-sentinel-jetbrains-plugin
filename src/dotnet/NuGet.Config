<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="resharper-platform" value="https://resharper-platform.jetbrains.com/api/v2/" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="Microsoft.*" />
      <package pattern="NETStandard.Library" />
      <package pattern="NHunspell" />
      <package pattern="Namotion.*" />
      <package pattern="NJsonSchema*" />
      <package pattern="Newtonsoft.Json" />
      <package pattern="NuGet.*" />
      <package pattern="NUnit*" />
      <package pattern="System.*" />
      <package pattern="JetBrains.*" />
      <package pattern="Wave" />
    </packageSource>
    <packageSource key="resharper-platform">
      <package pattern="JetBrains.*" />
      <package pattern="Wave" />
    </packageSource>
  </packageSourceMapping>
</configuration>

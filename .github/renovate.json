{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "enabledManagers": [
    "gradle",
    "gradle-wrapper",
    "nuget",
    "custom.regex",
    "github-actions"
  ],
  "dependencyDashboard": true,
  "ignoreUnstable": true,
  "osvVulnerabilityAlerts": false,
  "respectLatest": true,
  "vulnerabilityAlerts": {
    "enabled": false
  },
  "rangeStrategy": "bump",
  "prConcurrentLimit": 5,
  "labels": [
    "dependencies"
  ],
  "lockFileMaintenance": {
    "enabled": false
  },
  "packageRules": [
    {
      "description": "Disable inherited auto-merge for every dependency",
      "matchPackageNames": [
        "*"
      ],
      "automerge": false
    },
    {
      "description": "The rdgen Gradle plugin id is redirected in settings.gradle.kts to com.jetbrains.rd:rd-gen, whose version Renovate already tracks through the shared [versions] rdGen entry in gradle/libs.versions.toml, so the com.jetbrains.rdgen:com.jetbrains.rdgen.gradle.plugin marker artifact is never published and its lookup can only fail",
      "matchDepNames": [
        "com.jetbrains.rdgen"
      ],
      "enabled": false
    },
    {
      "description": "Group ordinary non-major Gradle and NuGet updates",
      "matchManagers": [
        "gradle",
        "gradle-wrapper",
        "nuget",
        "custom.regex"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "ordinary-build-dependencies"
    },
    {
      "description": "Group ordinary non-major GitHub Actions updates",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "groupName": "ordinary-github-actions"
    },
    {
      "description": "Merge non-major updates on their own once they have matured",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "minimumReleaseAge": "7 days",
      "automerge": true
    },
    {
      "description": "Keep the Renovate image update on its own, never automerged: it runs holding the App token",
      "matchPackageNames": [
        "renovate/renovate"
      ],
      "groupName": "renovate-image",
      "automerge": false
    },
    {
      "description": "Never automerge the actions that run inside the Renovate job itself: they hold or mint the App key, and CI / Gate never exercises that workflow",
      "matchPackageNames": [
        "renovatebot/github-action",
        "step-security/harden-runner",
        "actions/create-github-app-token"
      ],
      "groupName": "renovate-job-actions",
      "automerge": false
    },
    {
      "description": "Use stable Maven releases rather than repository publication order",
      "matchDatasources": [
        "maven"
      ],
      "respectLatest": true
    },
    {
      "description": "Keep JetBrains 2025.3 targets on their compatibility wave",
      "matchPackageNames": [
        "GO",
        "IIU",
        "JetBrains.Rider.SDK",
        "PCP",
        "PS",
        "RD",
        "RM",
        "RR",
        "WS"
      ],
      "matchCurrentValue": "/^2025\\.3\\./",
      "allowedVersions": "/^2025\\.3\\./"
    },
    {
      "description": "Keep JetBrains 2026.2 targets on their compatibility wave",
      "matchPackageNames": [
        "GO",
        "IIU",
        "PCP",
        "PS",
        "RD",
        "RM",
        "RR",
        "WS"
      ],
      "matchCurrentValue": "/^2026\\.2\\./",
      "allowedVersions": "/^2026\\.2\\./"
    },
    {
      "description": "Keep Coverlet compatible with the Rider net472 test host",
      "matchPackageNames": [
        "coverlet.collector"
      ],
      "allowedVersions": "<7.0.0"
    },
    {
      "description": "Keep the JDK on the Java 21 line the plugin targets",
      "matchPackageNames": [
        "java-jdk"
      ],
      "allowedVersions": "/^21\\./"
    },
    {
      "description": "Move the Rider IDE and SDKs together, merged by hand",
      "matchPackageNames": [
        "JetBrains.ReSharper.SDK.Tests",
        "JetBrains.Rider.SDK",
        "RD"
      ],
      "groupName": "rider-ide-and-sdk",
      "automerge": false
    }
  ],
  "customDatasources": {
    "jetbrains-products": {
      "defaultRegistryUrlTemplate": "https://data.services.jetbrains.com/products/releases?code={{{packageName}}}&type=release",
      "format": "json",
      "transformTemplates": [
        "{\"releases\": $reduce($each($, function($items) { $items }), $append, []).{\"version\": version, \"releaseTimestamp\": date}}"
      ]
    }
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^build\\.gradle\\.kts$/"
      ],
      "matchStrings": [
        "intellijIdea\\(\\s*\"(?<currentValue>[0-9.]+)\"\\s*\\)",
        "create\\(\\s*IntelliJPlatformType\\.IntellijIdea\\s*,\\s*\"(?<currentValue>[0-9.]+)\"\\s*\\)"
      ],
      "depNameTemplate": "IIU",
      "datasourceTemplate": "custom.jetbrains-products",
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^build\\.gradle\\.kts$/",
        "/^rider-frontend/build\\.gradle\\.kts$/"
      ],
      "matchStrings": [
        "type\\s*=\\s*IntelliJPlatformType\\.Rider[\\s\\S]{0,120}?version\\s*=\\s*\"(?<currentValue>[0-9.]+)\"",
        "create\\(\\s*IntelliJPlatformType\\.Rider\\s*,\\s*\"(?<currentValue>[0-9.]+)\"",
        "rider\\(\\s*\"(?<currentValue>[0-9.]+)\"\\s*\\)"
      ],
      "depNameTemplate": "RD",
      "datasourceTemplate": "custom.jetbrains-products",
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^build\\.gradle\\.kts$/"
      ],
      "matchStrings": [
        "type\\s*=\\s*IntelliJPlatformType\\.PyCharmProfessional[\\s\\S]{0,120}?version\\s*=\\s*\"(?<currentValue>[0-9.]+)\"",
        "create\\(\\s*IntelliJPlatformType\\.PyCharm(?:Professional)?\\s*,\\s*\"(?<currentValue>[0-9.]+)\"\\s*\\)"
      ],
      "depNameTemplate": "PCP",
      "datasourceTemplate": "custom.jetbrains-products",
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^build\\.gradle\\.kts$/"
      ],
      "matchStrings": [
        "type\\s*=\\s*IntelliJPlatformType\\.PhpStorm[\\s\\S]{0,120}?version\\s*=\\s*\"(?<currentValue>[0-9.]+)\"",
        "create\\(\\s*IntelliJPlatformType\\.PhpStorm\\s*,\\s*\"(?<currentValue>[0-9.]+)\"\\s*\\)"
      ],
      "depNameTemplate": "PS",
      "datasourceTemplate": "custom.jetbrains-products",
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^build\\.gradle\\.kts$/"
      ],
      "matchStrings": [
        "type\\s*=\\s*IntelliJPlatformType\\.RustRover[\\s\\S]{0,120}?version\\s*=\\s*\"(?<currentValue>[0-9.]+)\"",
        "create\\(\\s*IntelliJPlatformType\\.RustRover\\s*,\\s*\"(?<currentValue>[0-9.]+)\"\\s*\\)"
      ],
      "depNameTemplate": "RR",
      "datasourceTemplate": "custom.jetbrains-products",
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^build\\.gradle\\.kts$/"
      ],
      "matchStrings": [
        "type\\s*=\\s*IntelliJPlatformType\\.RubyMine[\\s\\S]{0,120}?version\\s*=\\s*\"(?<currentValue>[0-9.]+)\"",
        "create\\(\\s*IntelliJPlatformType\\.RubyMine\\s*,\\s*\"(?<currentValue>[0-9.]+)\"\\s*\\)"
      ],
      "depNameTemplate": "RM",
      "datasourceTemplate": "custom.jetbrains-products",
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^build\\.gradle\\.kts$/"
      ],
      "matchStrings": [
        "type\\s*=\\s*IntelliJPlatformType\\.WebStorm[\\s\\S]{0,120}?version\\s*=\\s*\"(?<currentValue>[0-9.]+)\"",
        "create\\(\\s*IntelliJPlatformType\\.WebStorm\\s*,\\s*\"(?<currentValue>[0-9.]+)\"\\s*\\)"
      ],
      "depNameTemplate": "WS",
      "datasourceTemplate": "custom.jetbrains-products",
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^build\\.gradle\\.kts$/"
      ],
      "matchStrings": [
        "type\\s*=\\s*IntelliJPlatformType\\.GoLand[\\s\\S]{0,120}?version\\s*=\\s*\"(?<currentValue>[0-9.]+)\"",
        "create\\(\\s*IntelliJPlatformType\\.GoLand\\s*,\\s*\"(?<currentValue>[0-9.]+)\"\\s*\\)"
      ],
      "depNameTemplate": "GO",
      "datasourceTemplate": "custom.jetbrains-products",
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^src/dotnet/Plugin\\.props$/"
      ],
      "matchStrings": [
        "<SdkVersion>(?<currentValue>[0-9.]+)</SdkVersion>"
      ],
      "depNameTemplate": "JetBrains.Rider.SDK",
      "datasourceTemplate": "nuget",
      "versioningTemplate": "nuget"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.java-version$/"
      ],
      "matchStrings": [
        "(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+\\+\\S+)"
      ],
      "depNameTemplate": "java-jdk",
      "datasourceTemplate": "java-version",
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/renovate\\.yml$/"
      ],
      "matchStrings": [
        "renovate-version:\\s*\"?(?<currentValue>[0-9.]+)@(?<currentDigest>sha256:[0-9a-f]{64})\"?"
      ],
      "depNameTemplate": "renovate/renovate",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ],
  "platformAutomerge": false,
  "automergeStrategy": "squash",
  "internalChecksFilter": "none",
  "rebaseWhen": "behind-base-branch",
  "postUpgradeTasks": {
    "commands": [
      "python3 scripts/sync-supply-chain.py --online"
    ],
    "fileFilters": [
      "config/supply-chain.json",
      "gradle.lockfile",
      "gradle/verification-metadata.xml"
    ],
    "executionMode": "branch"
  }
}

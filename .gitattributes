# The Python under scripts/ and tools/ is CI, release and fixture tooling, not the plugin, and
# it outweighs the Kotlin and C# it validates. Excluding it from Linguist keeps the language
# breakdown on the shipped code. These files stay first-party, so neither linguist-vendored nor
# linguist-generated would be true of them.
scripts/** linguist-detectable=false
tools/** linguist-detectable=false
